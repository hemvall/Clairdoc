{
  "name": "clairdoc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev --workspace=@clairdoc/api\" \"npm:dev --workspace=@clairdoc/web\"",
    "lint": "eslint .",
    "typecheck": "tsc --build && npm run typecheck --workspace @clairdoc/web",
    "test": "tsx --test apps/api/src/config.test.ts apps/api/src/server.test.ts",
    "build": "tsc --build && npm run build --workspace @clairdoc/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
